{
  "name": "owlcept",
  "private": true,
  "type": "module",
  "description": "OwlCept stops ClickFix-style paste-and-run attacks at copy, paste and Enter.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "extension",
    "web"
  ],
  "scripts": {
    "test": "npm test -w @owlcept/engine && npm test -w @owlcept/extension",
    "test:browser": "node scripts/ext-e2e.mjs && node scripts/web-e2e.mjs",
    "build": "npm run build -w @owlcept/extension && npm run build -w @owlcept/web",
    "logo": "node scripts/logo.mjs --render",
    "bench": "node bench/run.ts",
    "owlcept": "node packages/engine/cli/owlcept.ts",
    "stress": "node bench/stress.ts",
    "review-pack": "node bench/review-pack.ts"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
