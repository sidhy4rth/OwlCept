Windows Registry Editor Version 5.00

; OwlCept extension policy, example for a college lab. Import as administrator, or
; use Set-OwlCeptPolicy.ps1, which takes the same settings as parameters.
; Extension ID jjkhmdbenclipofjaeeblabpmjdcibpi is fixed by the manifest key.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\3rdparty\extensions\jjkhmdbenclipofjaeeblabpmjdcibpi\policy]
"mode"="smart"
"lang"="auto"
"contact"="919800000000"
"allowCopyAnyway"=dword:00000000
"reportLures"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\3rdparty\extensions\jjkhmdbenclipofjaeeblabpmjdcibpi\policy\trustedSites]
"1"="docs.example-college.edu.in"
"2"="learn.microsoft.com"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\3rdparty\extensions\jjkhmdbenclipofjaeeblabpmjdcibpi\policy]
"mode"="smart"
"lang"="auto"
"contact"="919800000000"
"allowCopyAnyway"=dword:00000000
"reportLures"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\3rdparty\extensions\jjkhmdbenclipofjaeeblabpmjdcibpi\policy\trustedSites]
"1"="docs.example-college.edu.in"
"2"="learn.microsoft.com"
